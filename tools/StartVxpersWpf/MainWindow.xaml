<ui:FluentWindow x:Class="StartVxpersWpf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="VxperS Control Center"
                 Width="880" Height="700"
                 MinWidth="720" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Resources>
        <!-- Small reusable style for the two "segmented" mode buttons -->
        <Style x:Key="SegmentButton" TargetType="ui:Button">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Appearance" Value="Secondary" />
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="#CBD5E1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="" Height="44">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="VXPERS" FontWeight="Black" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="  Control Center" FontSize="13" Opacity="0.55" VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,8,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Status row: two cards side by side ── -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Padding="16,14">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServerDot" Style="{StaticResource StatusDot}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="API Server" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="ServerCaption" Text="Offline" FontSize="11.5" Opacity="0.6" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" Padding="16,14">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ClientDot" Style="{StaticResource StatusDot}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="Web Client" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="ClientCaption" Text="Offline" FontSize="11.5" Opacity="0.6" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- ── Launch options ── -->
            <ui:Card Grid.Row="1" Padding="18,16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="LAUNCH OPTIONS" FontSize="10.5" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,32,0">
                            <TextBlock Text="Client mode" FontSize="12" Opacity="0.7" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="DevModeButton" Content="Dev · 5173" Style="{StaticResource SegmentButton}" Click="OnDevModeClick" />
                                <ui:Button x:Name="PreviewModeButton" Content="Preview · 4173" Style="{StaticResource SegmentButton}" Click="OnPreviewModeClick" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:ToggleSwitch x:Name="InstallDepsCheck" Content="Install dependencies (npm install)" Margin="0,0,0,8" />
                            <ui:ToggleSwitch x:Name="BuildCheck" Content="Rebuild client before preview" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ── Actions ── -->
            <ui:Card Grid.Row="2" Padding="18,14" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="StartButton" Content="Start All" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Click="OnStartClick" Padding="16,8" />
                    <ui:Button x:Name="StopButton" Content="Stop" Icon="{ui:SymbolIcon Stop24}" Click="OnStopClick" Padding="16,8" Margin="8,0,0,0" />
                    <ui:Button x:Name="RestartButton" Content="Restart" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRestartClick" Padding="16,8" Margin="8,0,0,0" />
                    <ui:Button x:Name="OpenBrowserButton" Content="Open in Browser" Icon="{ui:SymbolIcon Globe24}" Click="OnOpenBrowserClick" Padding="16,8" Margin="8,0,0,0" />

                    <Border Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="12,4" />

                    <TextBlock x:Name="StatusText" Text="Idle" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                </StackPanel>
            </ui:Card>

            <!-- ── Log ── -->
            <ui:Card Grid.Row="3" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,-27,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ACTIVITY LOG" FontSize="10.5" FontWeight="Bold" Opacity="0.5" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Content="Clear" Appearance="Transparent" FontSize="11" Padding="8,4" Click="OnClearLogClick" />
                    </Grid>

                    <Border Grid.Row="1" Background="#0B1220" CornerRadius="0,0,8,8" Margin="0">
                        <TextBox x:Name="LogBox"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Foreground="#CBD5E1"
                                 CaretBrush="#CBD5E1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="14,10" Height="255" VerticalAlignment="Top" />
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
