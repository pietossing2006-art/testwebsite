# Copy to manga_ocr_server/.env — keys and models are loaded by config.py on startup.

# Default provider when the UI does not pick one: gemini | openrouter | openai_compatible
TRANSLATION_PROVIDER=openrouter

# Optional shared key used when a provider-specific key below is empty
TRANSLATION_API_KEY=

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://www.vxpers.com
OPENROUTER_APP_NAME=VxperS MangaOCR

# --- OpenAI-compatible (OpenAI, Together, Groq, LM Studio, etc.) ---
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini
